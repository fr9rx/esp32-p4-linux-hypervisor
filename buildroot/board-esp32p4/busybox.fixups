# Generated once from the stock config by board/esp32p4/, then kept.
# Appended to busybox .config by BUSYBOX_KCONFIG_FIXUP_CMDS, which is the
# only layer that sticks: buildroot own fixups run after both
# BR2_PACKAGE_BUSYBOX_CONFIG and any *_CONFIG_FRAGMENT_FILES, and kconfig
# lets the last assignment of a symbol win.
# Enable: hush builtins /etc/profile needs.
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_EXPORT_N=y
CONFIG_HUSH_UNSET=y
CONFIG_HUSH_UMASK=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_TRAP=y
CONFIG_HUSH_KILL=y
CONFIG_HUSH_WAIT=y
CONFIG_HUSH_TYPE=y
CONFIG_HUSH_TIMES=y
CONFIG_HUSH_ECHO=y
CONFIG_HUSH_PRINTF=y
CONFIG_HUSH_TEST=y
CONFIG_HUSH_GETOPTS=y
CONFIG_HUSH_ULIMIT=y
CONFIG_HUSH_READONLY=y
CONFIG_HUSH_COMMAND=y
