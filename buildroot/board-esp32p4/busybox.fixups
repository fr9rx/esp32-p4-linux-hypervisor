# Three findings from nm --size-sort on busybox_unstripped.gdb:
#
#   usage_messages       36 KB of .data - uncompressed --help text
#   __EH_FRAME_BEGIN__   27 KB of .rodata - unwind tables nothing reads
#   fdisk/mkfs_ext2/od   ~9 KB of applets for block devices this board
#                        does not have (/ is romfs on flash)
#
# Every byte here comes off the per-process allocation, because binfmt_flat
# copies text+data+bss+stack into one contiguous block per exec.
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_EXTRA_CFLAGS="-fno-asynchronous-unwind-tables"
# CONFIG_FDISK is not set
# CONFIG_MKFS_EXT2 is not set
# CONFIG_MAKEDEVS is not set
# CONFIG_MDEV is not set
# Second pass, to get the flat footprint under 512 KB.
#
# This is the boundary that matters. binfmt_flat asks the page allocator for
# one contiguous block per exec, and the allocator charges a whole
# power-of-two: a 630 KB process occupies a 1 MB block, so 37% of the RAM it
# holds is waste. Crossing under 512 KB halves what each process actually
# costs and therefore roughly doubles how many can run at once.
#
# Kept deliberately: sed, grep, find, xargs, ps, top, free, dmesg, mount,
# umount, df, du, stat, printf, seq, test, kill, login, getty, su, passwd,
# init/halt/reboot, and all of the ordinary file and text tools.
# CONFIG_SHA3SUM is not set
# CONFIG_CHATTR is not set
# CONFIG_LSATTR is not set
# CONFIG_SWAPON is not set
# CONFIG_SWAPOFF is not set
# CONFIG_MKSWAP is not set
# CONFIG_BLKID is not set
# CONFIG_FINDFS is not set
# CONFIG_LSUSB is not set
# CONFIG_LSPCI is not set
# CONFIG_SETARCH is not set
# CONFIG_NSENTER is not set
# CONFIG_UNSHARE is not set
# CONFIG_SWITCH_ROOT is not set
# CONFIG_PIVOT_ROOT is not set
# CONFIG_LOSETUP is not set
# CONFIG_BLOCKDEV is not set
# CONFIG_FSTRIM is not set
# CONFIG_FALLOCATE is not set
# CONFIG_ACPID is not set
# CONFIG_BLKDISCARD is not set
# CONFIG_EJECT is not set
# CONFIG_FBSET is not set
# CONFIG_FDFLUSH is not set
# CONFIG_FDFORMAT is not set
# CONFIG_FREERAMDISK is not set
# CONFIG_FSCK_MINIX is not set
