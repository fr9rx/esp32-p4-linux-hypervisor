# Buildroot's busybox kconfig cannot be steered from BR2_PACKAGE_BUSYBOX_CONFIG
# or from BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES: BUSYBOX_KCONFIG_FIXUP_CMDS
# runs after both of them, and this kconfig keeps the FIRST assignment of a
# symbol, so appending to .config has no effect either. The only layer that
# reliably wins is a fixup command, applied last, that deletes each symbol's
# existing line before writing the new one -- which is what
# board/esp32p4/busybox-fixup.sh does.
#
# Symptoms without this: every disable in board/esp32p4/busybox.fixups is
# silently ignored, and /etc/profile fails on its first line because
# buildroot enables CONFIG_HUSH_EXPORT_N without the CONFIG_HUSH_EXPORT it
# depends on.
#
# Apply with:  patch -p1 -d <buildroot> < busybox-fixups-hook.patch
--- a/package/busybox/busybox.mk
+++ b/package/busybox/busybox.mk
@@ -455,6 +455,7 @@ define BUSYBOX_KCONFIG_FIXUP_CMDS
 	$(BUSYBOX_SET_INDIVIDUAL_BINARIES)
 	$(BUSYBOX_DISABLE_IP_LINK_CAN)
 	$(PACKAGES_BUSYBOX_CONFIG_FIXUPS)
+	board/esp32p4/busybox-fixup.sh $(@D)/.config board/esp32p4/busybox.fixups
 endef
